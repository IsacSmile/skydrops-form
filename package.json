{
  "name": "skydrops-form",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx scripts/verify-schema.ts",
    "auth:verify": "tsx scripts/verify-auth.ts",
    "forms:verify": "tsx scripts/verify-forms.ts",
    "fields:verify": "tsx scripts/verify-fields.ts",
    "reorder:verify": "tsx scripts/verify-reorder.ts",
    "status:verify": "tsx scripts/verify-status.ts",
    "submit:verify": "tsx scripts/verify-submit.ts",
    "sheets:check": "tsx --env-file=.env.local scripts/sheets-check.ts",
    "sheets:verify": "tsx --env-file=.env.local scripts/verify-sheets.ts",
    "submissions:verify": "tsx --env-file=.env.local scripts/verify-submissions.ts",
    "uploads:verify": "tsx --env-file=.env.local scripts/verify-uploads.ts",
    "predeploy": "tsx --env-file=.env.local scripts/predeploy-check.ts",
    "hardening:verify": "tsx --env-file=.env.local scripts/verify-hardening.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
