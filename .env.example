# Neon Postgres connection string
DATABASE_URL=

# Shared admin password for dashboard access
ADMIN_PASSWORD=

# Secret key for encrypting and signing session cookies
SESSION_SECRET=

# Google Service Account client email for Google Sheets API
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Google Service Account private key in PEM format
GOOGLE_PRIVATE_KEY=

# Google Spreadsheet ID for submissions mirror
GOOGLE_SHEET_ID=

# Vercel Blob read/write token for file uploads
BLOB_READ_WRITE_TOKEN=

# Base public application URL (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=
